---
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import ShopState from '../components/ShopState.astro';
import Shop from '../layouts/Shop.astro';
import { loadCatalog } from '../lib/load';
import { canOrder } from '../lib/models';

// Filters live in the address (?category=&series=&q=&stock=1) so they work
// without JavaScript and can be shared as links.
const params = Astro.url.searchParams;
const categoryId = params.get('category');
const seriesId = params.get('series');
const query = (params.get('q') ?? '').trim();
const inStockOnly = params.get('stock') === '1';

const result = await loadCatalog();

function link(change: Record<string, string | null>) {
  const next = new URLSearchParams(params);
  for (const [k, v] of Object.entries(change)) (v === null ? next.delete(k) : next.set(k, v));
  const qs = next.toString();
  return qs ? `/?${qs}` : '/';
}
---
<Shop title={result.ok ? result.catalog.settings.name : 'Shop'} tab="shop">
  {
    !result.ok ? (
      <ShopState kind={result.kind} />
    ) : (
      (() => {
        const { catalog } = result;
        const q = query.toLowerCase();
        const products = catalog.products
          .filter(
            (p) =>
              (!categoryId || p.categoryId === categoryId) &&
              (!seriesId || p.seriesId === seriesId) &&
              (!inStockOnly || p.availability === 'inStock' || p.availability === 'fewLeft') &&
              (!q || p.name.toLowerCase().includes(q) || p.description.toLowerCase().includes(q)),
          )
          .sort((a, b) => Number(!canOrder(a)) - Number(!canOrder(b)));
        const series = catalog.series.find((s) => s.id === seriesId);
        const seriesName = (id: string | null) => catalog.series.find((s) => s.id === id)?.name ?? null;
        const filtersOn = !!seriesId || inStockOnly;
        return (
          <>
            <header class="flex items-center gap-3 px-5 pt-5 md:px-8 md:pt-8">
              <img src="/brand/icon-192.png" alt="" width="40" height="40" class="size-10 rounded-xl" />
              <h1 class="display flex-1 text-3xl">{catalog.settings.name}</h1>
              <a href="/browse" class="circle-btn" aria-label="Browse by series">
                <Icon name="grid" size={20} />
              </a>
            </header>

            {!categoryId && !seriesId && !query && !inStockOnly && (
              <section class="mx-5 mt-4 flex items-center gap-4 rounded-[28px] bg-brand p-4 text-ink-deep md:mx-8 md:gap-8 md:px-8 md:py-6">
                <img src="/brand/logo.webp" alt="Anime Yahh! Otaku approved" width="282" height="257" class="h-28 w-auto shrink-0 md:h-40" />
                <div>
                  <p class="display text-3xl leading-none text-balance md:text-5xl">Anime merch for real otakus</p>
                  <p class="mt-1.5 text-sm md:mt-3 md:text-base">
                    Jerseys, figures and accessories. Order on WhatsApp
                    {catalog.settings.deliveryAreas.length === 0 ? ', delivery included.' : '.'}
                  </p>
                </div>
              </section>
            )}

            <form action="/" method="get" role="search" class="mt-5 flex gap-3 px-5 md:max-w-xl md:px-8">
              {categoryId && <input type="hidden" name="category" value={categoryId} />}
              {seriesId && <input type="hidden" name="series" value={seriesId} />}
              {inStockOnly && <input type="hidden" name="stock" value="1" />}
              <label class="relative flex-1">
                <span class="sr-only">Search</span>
                <Icon name="search" size={20} class="absolute top-1/2 left-3.5 -translate-y-1/2 text-grey-light" />
                <input id="q" name="q" type="search" value={query} placeholder="Search merch…" class="field pl-11" enterkeyhint="search" />
              </label>
              <details class="group relative">
                <summary class="relative grid size-[50px] cursor-pointer list-none place-items-center rounded-full bg-ink text-white [&::-webkit-details-marker]:hidden" aria-label="Filters">
                  <Icon name="sliders" size={22} />
                  {filtersOn && <span class="absolute top-1 right-1 size-2.5 rounded-full border-2 border-white bg-brand" />}
                </summary>
                <div class="absolute top-14 right-0 z-30 w-[min(18rem,calc(100vw-2.5rem))] rounded-2xl border border-line bg-white p-4 shadow-xl">
                  <p class="font-semibold">Anime series</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <a href={link({ series: null })} class={`pill ${!seriesId ? 'pill-on' : ''}`}>All series</a>
                    {catalog.series.map((s) => (
                      <a href={link({ series: s.id })} class={`pill ${seriesId === s.id ? 'pill-on' : ''}`}>{s.name}</a>
                    ))}
                  </div>
                  <a href={link({ stock: inStockOnly ? null : '1' })} class="mt-4 flex items-center justify-between gap-3" role="switch" aria-checked={inStockOnly ? 'true' : 'false'}>
                    <span>
                      <span class="block font-medium">In stock only</span>
                      <span class="block text-sm muted">Hide pre-order items</span>
                    </span>
                    <span class={`relative h-7 w-12 rounded-full transition ${inStockOnly ? 'bg-brand' : 'bg-line'}`}>
                      <span class={`absolute top-1 size-5 rounded-full bg-white transition ${inStockOnly ? 'left-6' : 'left-1'}`} />
                    </span>
                  </a>
                </div>
              </details>
            </form>

            <nav aria-label="Categories" class="mt-5 flex gap-2.5 overflow-x-auto px-5 pb-1 [scrollbar-width:none] md:px-8">
              <a href={link({ category: null })} class={`pill ${!categoryId ? 'pill-on' : ''}`} aria-current={!categoryId ? 'page' : undefined}>
                <Icon name="grid" size={18} /> All items
              </a>
              {catalog.categories.map((c) => (
                <a href={link({ category: categoryId === c.id ? null : c.id })} class={`pill ${categoryId === c.id ? 'pill-on' : ''}`} aria-current={categoryId === c.id ? 'page' : undefined}>
                  {c.name}
                </a>
              ))}
            </nav>

            {(series || query) && (
              <div class="mt-3 flex flex-wrap gap-2 px-5 md:px-8">
                {series && (
                  <a href={link({ series: null })} class="pill text-sm">
                    Series: {series.name} <Icon name="close" size={16} />
                  </a>
                )}
                {query && (
                  <a href={link({ q: null })} class="pill text-sm">
                    “{query}” <Icon name="close" size={16} />
                  </a>
                )}
              </div>
            )}

            {products.length === 0 ? (
              <div class="flex flex-col items-center px-8 py-20 text-center">
                <div class="grid size-18 place-items-center rounded-full bg-surface text-grey">
                  <Icon name="search" size={32} />
                </div>
                <h2 class="display mt-4 text-2xl">Nothing found</h2>
                <p class="mt-2 muted">Try another search or clear the filters.</p>
                <a href="/" class="btn-outline mt-6 max-w-48">Clear filters</a>
              </div>
            ) : (
              <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-6 px-5 sm:grid-cols-3 md:px-8 lg:grid-cols-4 lg:gap-x-6">
                {products.map((p) => <ProductCard product={p} seriesName={seriesName(p.seriesId)} />)}
              </ul>
            )}
          </>
        );
      })()
    )
  }
</Shop>
