---
import Admin from '../../layouts/Admin.astro';
import { STATUS, when } from '../../lib/admin/format';
import { orderOwed, orderTotal } from '../../lib/admin/types';
import { kwacha } from '../../lib/money';

const admin = Astro.locals.admin!;
const [s, open] = await Promise.all([admin.summary(), admin.orders({ status: 'open', limit: 8 })]);
const tiles = [
  { label: 'Sales today', value: kwacha(s.salesToday) },
  { label: 'Last 7 days', value: kwacha(s.salesWeek) },
  { label: 'This month', value: kwacha(s.salesMonth), note: `${s.ordersMonth} ${s.ordersMonth === 1 ? 'sale' : 'sales'}` },
  { label: 'Received this month', value: kwacha(s.receivedMonth), note: 'Cash and mobile money' },
];
---
<Admin title="Home" tab="home">
  <h1 class="display text-4xl">Dashboard</h1>

  <section aria-label="Sales" class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
    {
      tiles.map((t, i) => (
        <div class="rise rounded-3xl bg-white p-4" style={`--i: ${i}`}>
          <p class="text-sm muted">{t.label}</p>
          <p class="figure mt-1 text-[28px] leading-tight">{t.value}</p>
          {t.note && <p class="text-xs muted">{t.note}</p>}
        </div>
      ))
    }
  </section>

  <section aria-label="To do" class="mt-3 grid gap-3 sm:grid-cols-3">
    <a href="/admin/orders?status=received" class="rise flex items-center justify-between rounded-3xl bg-brand p-4 text-ink-deep transition hover:-translate-y-0.5" style="--i: 4">
      <span><span class="block text-sm font-semibold">New orders</span><span class="text-xs">Confirm on WhatsApp</span></span>
      <span class="figure text-4xl">{s.newOrders}</span>
    </a>
    <a href="/admin/orders?status=open" class="rise flex items-center justify-between rounded-3xl bg-ink-deep p-4 text-white transition hover:-translate-y-0.5" style="--i: 5">
      <span><span class="block text-sm font-semibold">To deliver</span><span class="text-xs text-white/70">Confirmed or ready</span></span>
      <span class="figure text-4xl">{s.toDeliver}</span>
    </a>
    <a href="/admin/orders?owed=1" class="rise flex items-center justify-between rounded-3xl bg-white p-4 transition hover:-translate-y-0.5" style="--i: 6">
      <span><span class="block text-sm font-semibold">Owed to you</span><span class="text-xs muted">Not yet paid</span></span>
      <span class="figure text-3xl">{kwacha(s.owed)}</span>
    </a>
  </section>

  <div class="mt-6 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
    <section aria-labelledby="open-h" class="rounded-3xl bg-white p-4 md:p-5">
      <div class="flex items-center justify-between">
        <h2 id="open-h" class="display text-2xl">Open orders</h2>
        <a href="/admin/orders" class="text-sm font-semibold text-brand-deep">All orders</a>
      </div>
      {open.length === 0 ? (
        <p class="mt-3 muted">Nothing waiting. New website orders appear here.</p>
      ) : (
        <ul class="mt-2 divide-y divide-line">
          {open.map((o) => (
            <li>
              <a href={`/admin/orders/${o.code}`} class="flex items-center gap-3 py-3 hover:bg-surface/50">
                <span class={`rounded-full px-2.5 py-1 text-xs font-semibold ${STATUS[o.status].tone}`}>{STATUS[o.status].label}</span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate font-semibold">{o.customerName}</span>
                  <span class="block text-xs muted">{o.code} · {when(o.createdAt)}</span>
                </span>
                <span class="text-right">
                  <span class="block font-semibold tabular-nums">{kwacha(orderTotal(o))}</span>
                  {o.status !== 'received' && orderOwed(o) > 0 && <span class="block text-xs text-sale">owes {kwacha(orderOwed(o))}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    <div class="grid content-start gap-6">
      <section aria-labelledby="low-h" class="rounded-3xl bg-white p-4 md:p-5">
        <h2 id="low-h" class="display text-2xl">Running low</h2>
        {s.lowStock.length === 0 ? (
          <p class="mt-2 text-sm muted">Nothing low. Products show here once you enter stock counts.</p>
        ) : (
          <ul class="mt-2 grid gap-1.5">
            {s.lowStock.slice(0, 10).map((l) => (
              <li>
                <a href={`/admin/products/${l.productId}#stock`} class="flex justify-between gap-3 text-sm hover:text-brand-deep">
                  <span class="truncate">{l.name}{l.size && <span class="muted"> · {l.size}</span>}</span>
                  <span class={`font-semibold tabular-nums ${l.qty === 0 ? 'text-sale' : ''}`}>{l.qty === 0 ? 'Out' : `${l.qty} left`}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>

      {s.topSellers.length > 0 && (
        <section aria-labelledby="top-h" class="rounded-3xl bg-white p-4 md:p-5">
          <h2 id="top-h" class="display text-2xl">Best sellers · 30 days</h2>
          <ol class="mt-2 grid gap-1.5 text-sm">
            {s.topSellers.map((t) => (
              <li class="flex justify-between gap-3"><span class="truncate">{t.name}</span><span class="font-semibold">{t.qty}</span></li>
            ))}
          </ol>
        </section>
      )}
    </div>
  </div>
</Admin>
