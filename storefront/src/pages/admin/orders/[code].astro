---
import Admin from '../../../layouts/Admin.astro';
import { METHOD, STATUS, flash, kwachaInput, parseKwacha, when } from '../../../lib/admin/format';
import { AdminError, orderOwed, orderPaid, orderTotal, type PaymentMethod } from '../../../lib/admin/types';
import type { OrderStatus } from '../../../lib/models';
import { kwacha } from '../../../lib/money';

const admin = Astro.locals.admin!;
const code = Astro.params.code ?? '';
const here = `/admin/orders/${code}`;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');
  try {
    if (action === 'status') {
      const status = String(form.get('status')) as OrderStatus;
      await admin.setStatus(code, status);
      return Astro.redirect(flash(here, 'ok', `Marked ${STATUS[status].label.toLowerCase()}`), 303);
    }
    if (action === 'payment') {
      const amount = parseKwacha(form.get('amount'));
      const method = form.get('method') === 'cash' ? 'cash' : ('mobile_money' as PaymentMethod);
      if (!amount) return Astro.redirect(flash(here, 'err', 'Enter the amount paid, e.g. 250'), 303);
      await admin.addPayment(code, amount, method, String(form.get('note') ?? '').slice(0, 200));
      return Astro.redirect(flash(here, 'ok', `${kwacha(amount)} ${METHOD[method].toLowerCase()} payment recorded`), 303);
    }
    if (action === 'delete-payment') {
      await admin.deletePayment(Number(form.get('id')));
      return Astro.redirect(flash(here, 'ok', 'Payment removed'), 303);
    }
  } catch (e) {
    return Astro.redirect(flash(here, 'err', e instanceof AdminError ? e.message : 'Something went wrong. Try again.'), 303);
  }
}

const o = await admin.order(code);
if (!o) Astro.response.status = 404;

// What can happen next, from where the order is now.
const next: Record<OrderStatus, { status: OrderStatus; label: string; primary?: boolean }[]> = {
  received: [{ status: 'confirmed', label: 'Confirm order', primary: true }],
  confirmed: [{ status: 'ready', label: 'Mark ready', primary: true }, { status: 'delivered', label: 'Mark delivered' }],
  ready: [{ status: 'delivered', label: 'Mark delivered', primary: true }],
  delivered: [{ status: 'confirmed', label: 'Not delivered after all' }],
  cancelled: [{ status: 'received', label: 'Reopen order' }],
};
const owed = o ? orderOwed(o) : 0;
const waLink =
  o?.phone &&
  `https://wa.me/${o.phone}?text=${encodeURIComponent(`Hi ${o.customerName.split(' ')[0]}, this is AnimeYay about your order ${o.code}.`)}`;
---
<Admin title={o ? `Order ${o.code}` : 'Order not found'} tab="orders">
  <a href="/admin/orders" class="text-sm font-semibold text-brand-deep">← Orders</a>
  {
    !o ? (
      <p class="mt-8 text-center muted">Order {code} wasn’t found.</p>
    ) : (
      <div class="mt-3 grid gap-5 lg:grid-cols-[1.3fr_1fr]">
        <section class="rounded-3xl bg-white p-5">
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="display text-4xl">{o.code}</h1>
            <span class={`rounded-full px-3 py-1 text-sm font-semibold ${STATUS[o.status].tone}`}>{STATUS[o.status].label}</span>
          </div>
          <p class="mt-1 text-sm muted">
            {o.source === 'website' ? 'Website order' : 'Recorded in person'} · {when(o.createdAt)}
          </p>

          <div class="mt-4 rounded-2xl bg-surface p-4">
            <p class="font-semibold">{o.customerName}</p>
            {o.phone && <p class="text-sm tabular-nums">+{o.phone}</p>}
            {o.areaName && <p class="text-sm">Delivery: {o.areaName}</p>}
            {o.notes && <p class="mt-1 text-sm muted">“{o.notes}”</p>}
            {waLink && (
              <a href={waLink} target="_blank" rel="noopener" class="mt-3 inline-flex rounded-full bg-ink-deep px-4 py-2 text-sm font-semibold text-white">
                Message on WhatsApp
              </a>
            )}
          </div>

          <ul class="mt-4 divide-y divide-line">
            {o.items.map((it) => (
              <li class="flex justify-between gap-3 py-2.5">
                <span>
                  <a href={`/admin/products/${it.productId}`} class="font-semibold hover:text-brand-deep">{it.qty}× {it.name}</a>
                  <span class="block text-xs muted">
                    {[it.size && `Size ${it.size}`, it.color, it.preOrder && 'Pre-order', `${kwacha(it.unitPriceZmw)} each`].filter(Boolean).join(' · ')}
                  </span>
                </span>
                <span class="font-semibold tabular-nums">{kwacha(it.qty * it.unitPriceZmw)}</span>
              </li>
            ))}
          </ul>
          <dl class="mt-2 grid gap-1 border-t border-line pt-3 tabular-nums">
            {o.deliveryZmw > 0 && <div class="flex justify-between text-sm"><dt>Delivery</dt><dd>{kwacha(o.deliveryZmw)}</dd></div>}
            <div class="flex items-baseline justify-between"><dt class="display text-2xl">Total</dt><dd class="figure text-2xl">{kwacha(orderTotal(o))}</dd></div>
            {o.depositZmw > 0 && <div class="flex justify-between text-sm muted"><dt>Pre-order deposit asked</dt><dd>{kwacha(o.depositZmw)}</dd></div>}
          </dl>

          <div class="mt-5 flex flex-wrap gap-2">
            {next[o.status].map((n) => (
              <form method="post">
                <input type="hidden" name="action" value="status" />
                <input type="hidden" name="status" value={n.status} />
                <button class={n.primary ? 'btn-primary h-12 px-6' : 'btn-outline h-12 px-5'}>{n.label}</button>
              </form>
            ))}
            {o.status !== 'cancelled' && (
              <form method="post" onsubmit="return confirm('Cancel this order? Items go back into stock.')">
                <input type="hidden" name="action" value="status" />
                <input type="hidden" name="status" value="cancelled" />
                <button class="h-12 rounded-full px-5 font-semibold text-sale hover:bg-[#fdecec]">Cancel order</button>
              </form>
            )}
          </div>
          {o.status === 'received' && (
            <p class="mt-2 text-xs muted">Confirming takes the items out of stock. Cancelling later puts them back.</p>
          )}
        </section>

        <section class="rounded-3xl bg-white p-5" aria-labelledby="pay-h">
          <h2 id="pay-h" class="display text-2xl">Payments</h2>
          <div class="mt-2 grid grid-cols-2 gap-2 text-center">
            <div class="rounded-2xl bg-surface p-3"><p class="text-xs muted">Paid</p><p class="figure text-2xl">{kwacha(orderPaid(o))}</p></div>
            <div class={`rounded-2xl p-3 ${owed > 0 ? 'bg-[#fdecec] text-sale' : 'bg-[#e8f5ec] text-[#1f6f43]'}`}>
              <p class="text-xs">{owed > 0 ? 'Still owed' : 'Fully paid'}</p><p class="figure text-2xl">{kwacha(owed)}</p>
            </div>
          </div>

          {o.payments.length > 0 && (
            <ul class="mt-3 divide-y divide-line">
              {o.payments.map((p) => (
                <li class="flex items-center gap-3 py-2 text-sm">
                  <span class="flex-1">
                    <span class="font-semibold tabular-nums">{kwacha(p.amountZmw)}</span> · {METHOD[p.method]}
                    <span class="block text-xs muted">{when(p.paidAt)}{p.note && ` · ${p.note}`}</span>
                  </span>
                  <form method="post" onsubmit="return confirm('Remove this payment?')">
                    <input type="hidden" name="action" value="delete-payment" />
                    <input type="hidden" name="id" value={p.id} />
                    <button class="rounded-full px-2 py-1 text-xs font-semibold text-grey hover:text-sale" aria-label={`Remove ${kwacha(p.amountZmw)} payment`}>Remove</button>
                  </form>
                </li>
              ))}
            </ul>
          )}

          {o.status !== 'cancelled' && owed > 0 && (
            <form method="post" class="mt-4 grid gap-3 border-t border-line pt-4">
              <input type="hidden" name="action" value="payment" />
              <p class="font-semibold">Record a payment</p>
              <label class="grid gap-1">
                <span class="text-sm muted">Amount (K)</span>
                <input name="amount" inputmode="decimal" required class="field" value={kwachaInput(owed)} />
              </label>
              <fieldset class="flex gap-2">
                <legend class="sr-only">Paid by</legend>
                <label class="pill cursor-pointer has-[:checked]:border-brand has-[:checked]:bg-brand has-[:checked]:font-semibold has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-brand-deep"><input type="radio" name="method" value="mobile_money" checked class="sr-only" />Mobile money</label>
                <label class="pill cursor-pointer has-[:checked]:border-brand has-[:checked]:bg-brand has-[:checked]:font-semibold has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-brand-deep"><input type="radio" name="method" value="cash" class="sr-only" />Cash</label>
              </fieldset>
              <input name="note" class="field" placeholder="Note (optional), e.g. Airtel ref" maxlength="200" />
              <button class="btn-primary">Save payment</button>
            </form>
          )}
        </section>
      </div>
    )
  }
</Admin>
