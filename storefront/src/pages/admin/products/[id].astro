---
import PhotoUpload from '../../../islands/admin/PhotoUpload';
import Admin from '../../../layouts/Admin.astro';
import { AVAILABILITY, flash, kwachaInput, parseKwacha, slugify } from '../../../lib/admin/format';
import { AdminError, stockTotal, type AdminProduct, type ProductInput } from '../../../lib/admin/types';
import type { Availability } from '../../../lib/models';

const admin = Astro.locals.admin!;
const id = Astro.params.id ?? '';
const isNew = id === 'new';
const here = `/admin/products/${id}`;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');
  try {
    const existing = isNew ? null : await admin.product(id);
    if (!isNew && !existing) return Astro.redirect('/admin/products', 303);

    if (action === 'save') {
      const name = String(form.get('name') ?? '').trim();
      const price = parseKwacha(form.get('price'));
      const compareRaw = String(form.get('compareAt') ?? '').trim();
      const compareAt = compareRaw ? parseKwacha(compareRaw) : null;
      if (!name) return Astro.redirect(flash(here, 'err', 'Give the product a name'), 303);
      if (!price) return Astro.redirect(flash(here, 'err', 'Enter a price, e.g. 250'), 303);
      if (compareRaw && !compareAt) return Astro.redirect(flash(here, 'err', 'The old price should be a number, e.g. 300'), 303);
      const sizes = [...new Set(String(form.get('sizes') ?? '').split(/[,\s]+/).map((s) => s.trim().toUpperCase()).filter(Boolean))].slice(0, 12);
      const preOrder = form.get('mode') === 'preOrder';
      const handSet = (['inStock', 'fewLeft', 'soldOut'] as const).find((a) => a === form.get('availability')) ?? 'inStock';
      const weeks = Number(form.get('weeks'));

      let productId = id;
      if (isNew) {
        // A readable, unique address for the product page, e.g. /p/nezuko-jersey.
        const taken = new Set(['new', ...(await admin.products()).map((p) => p.id)]);
        const base = slugify(name) || 'product';
        productId = base;
        for (let n = 2; taken.has(productId); n++) productId = `${base}-${n}`;
      }
      const input: ProductInput = {
        id: productId,
        name: name.slice(0, 120),
        description: String(form.get('description') ?? '').slice(0, 2000),
        categoryId: String(form.get('categoryId')),
        seriesId: String(form.get('seriesId') ?? '') || null,
        priceZmw: price,
        compareAtZmw: compareAt,
        photos: existing?.photos ?? [],
        sizes,
        availability: (preOrder ? 'preOrder' : existing?.trackStock ? existing.availability === 'preOrder' ? 'inStock' : existing.availability : handSet) as Availability,
        leadTimeWeeks: preOrder && weeks >= 1 && weeks <= 52 ? Math.round(weeks) : null,
        published: form.get('published') === 'on',
      };
      await admin.saveProduct(input);
      return Astro.redirect(flash(`/admin/products/${productId}`, 'ok', isNew ? 'Product added. Now add photos and stock.' : 'Saved'), 303);
    }

    if (action === 'stock' && existing) {
      const add = form.get('mode') === 'add';
      const keys = existing.sizes.length ? existing.sizes : [''];
      for (const k of keys) {
        const raw = String(form.get(`qty:${k}`) ?? '').trim();
        if (raw === '') continue;
        const n = Number(raw);
        if (!Number.isInteger(n) || n < 0 || n > 9999) return Astro.redirect(flash(here, 'err', 'Counts must be whole numbers'), 303);
        const qty = add ? (existing.stock[k] ?? 0) + n : n;
        if (add && n === 0) continue;
        await admin.setStock(id, k, qty, add ? 'restock' : 'correction');
      }
      return Astro.redirect(flash(`${here}#stock`, 'ok', add ? 'New stock added' : 'Stock counts saved'), 303);
    }

    if (action === 'stop-tracking' && existing) {
      await admin.stopTracking(id);
      return Astro.redirect(flash(`${here}#stock`, 'ok', 'Stock is no longer counted for this product'), 303);
    }

    if (action === 'photos' && existing) {
      const photos = [...existing.photos];
      const i = Number(form.get('index'));
      if (form.get('op') === 'remove') photos.splice(i, 1);
      if (form.get('op') === 'first' && i > 0) photos.unshift(...photos.splice(i, 1));
      await admin.saveProduct({ ...toInput(existing), photos });
      return Astro.redirect(flash(`${here}#photos`, 'ok', 'Photos updated'), 303);
    }
  } catch (e) {
    return Astro.redirect(flash(here, 'err', e instanceof AdminError ? e.message : 'Couldn’t save. Try again.'), 303);
  }
}

function toInput(p: AdminProduct): ProductInput {
  const { id, name, description, categoryId, seriesId, priceZmw, compareAtZmw, photos, sizes, availability, leadTimeWeeks, published } = p;
  return { id, name, description, categoryId, seriesId, priceZmw, compareAtZmw, photos, sizes, availability, leadTimeWeeks, published };
}

const [p, { categories, series }] = await Promise.all([isNew ? Promise.resolve(null) : admin.product(id), admin.lists()]);
if (!isNew && !p) Astro.response.status = 404;
const keys = p ? (p.sizes.length ? p.sizes : ['']) : [];
const preOrder = p?.availability === 'preOrder';
---
<Admin title={isNew ? 'Add product' : p?.name ?? 'Not found'} tab="products">
  <a href="/admin/products" class="text-sm font-semibold text-brand-deep">← Products</a>
  {
    !isNew && !p ? (
      <p class="mt-8 text-center muted">Product not found.</p>
    ) : (
      <div class="mt-3 grid gap-5 lg:grid-cols-[1.2fr_1fr]">
        <form method="post" class="grid content-start gap-3 rounded-3xl bg-white p-5">
          <input type="hidden" name="action" value="save" />
          <div class="flex items-center justify-between gap-3">
            <h1 class="display text-3xl">{isNew ? 'Add product' : 'Details'}</h1>
            {p && <a href={`/p/${p.id}`} target="_blank" class="text-sm font-semibold text-brand-deep">View on shop ↗</a>}
          </div>
          <label class="grid gap-1"><span class="text-sm font-semibold">Name</span>
            <input name="name" required maxlength="120" class="field" value={p?.name} placeholder="e.g. Nezuko Kamado Jersey" />
          </label>
          <label class="grid gap-1"><span class="text-sm font-semibold">Description</span>
            <textarea name="description" rows="3" maxlength="2000" class="field">{p?.description}</textarea>
          </label>
          <div class="grid grid-cols-2 gap-3">
            <label class="grid gap-1"><span class="text-sm font-semibold">Price (K)</span>
              <input name="price" required inputmode="decimal" class="field" value={kwachaInput(p?.priceZmw ?? null)} placeholder="250" />
            </label>
            <label class="grid gap-1"><span class="text-sm font-semibold">Old price (K)</span>
              <input name="compareAt" inputmode="decimal" class="field" value={kwachaInput(p?.compareAtZmw ?? null)} placeholder="Optional, shows as a sale" />
            </label>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <label class="grid gap-1"><span class="text-sm font-semibold">Category</span>
              <select name="categoryId" class="field">
                {categories.map((c) => <option value={c.id} selected={p?.categoryId === c.id}>{c.name}</option>)}
              </select>
            </label>
            <label class="grid gap-1"><span class="text-sm font-semibold">Anime series</span>
              <select name="seriesId" class="field">
                <option value="">None</option>
                {series.map((s) => <option value={s.id} selected={p?.seriesId === s.id}>{s.name}</option>)}
              </select>
            </label>
          </div>
          <label class="grid gap-1"><span class="text-sm font-semibold">Sizes</span>
            <input name="sizes" class="field" value={p?.sizes.join(', ')} placeholder="e.g. S, M, L, XL — leave empty if none" />
          </label>

          <fieldset class="grid gap-2">
            <legend class="text-sm font-semibold">Selling</legend>
            <label class="flex items-center gap-2"><input type="radio" name="mode" value="now" checked={!preOrder} class="accent-[#fd7312]" /> Available now</label>
            <label class="flex items-center gap-2"><input type="radio" name="mode" value="preOrder" checked={preOrder} class="accent-[#fd7312]" /> Pre-order, arrives in
              <input name="weeks" type="number" min="1" max="52" class="field w-20 px-2 py-1.5" value={p?.leadTimeWeeks ?? 3} aria-label="Weeks until it arrives" /> weeks
            </label>
          </fieldset>
          {(isNew || !p?.trackStock) && (
            <label class="grid gap-1"><span class="text-sm font-semibold">Availability</span>
              <select name="availability" class="field">
                {(['inStock', 'fewLeft', 'soldOut'] as const).map((a) => <option value={a} selected={p?.availability === a}>{AVAILABILITY[a]}</option>)}
              </select>
              <span class="text-xs muted">Set by hand until you enter stock counts below.</span>
            </label>
          )}
          <label class="flex items-center gap-2 font-semibold"><input type="checkbox" name="published" checked={p ? p.published : true} class="size-5 accent-[#fd7312]" /> Show on the website</label>
          <button class="btn-primary mt-1">{isNew ? 'Add product' : 'Save details'}</button>
        </form>

        {p && (
          <div class="grid content-start gap-5">
            <section id="stock" class="scroll-mt-24 rounded-3xl bg-white p-5" aria-labelledby="stock-h">
              <h2 id="stock-h" class="display text-3xl">Stock</h2>
              {p.availability === 'preOrder' ? (
                <p class="mt-1 text-sm muted">Pre-orders don’t use stock. Switch to “Available now” when it arrives, then enter the counts.</p>
              ) : p.trackStock ? (
                <p class="mt-1 text-sm muted">
                  {stockTotal(p)} in stock. The website shows <strong>{AVAILABILITY[p.availability]}</strong> and greys out sizes that run out.
                </p>
              ) : (
                <p class="mt-1 text-sm muted">Enter how many you have. From then on, sales take stock off and the website updates by itself.</p>
              )}
              {p.availability !== 'preOrder' && (
                <form method="post" class="mt-3">
                  <input type="hidden" name="action" value="stock" />
                  <div class="grid grid-cols-3 gap-2 sm:grid-cols-4">
                    {keys.map((k) => (
                      <label class="grid gap-1 rounded-2xl bg-surface p-2.5">
                        <span class="text-xs font-semibold">{k || 'Count'} <span class="font-normal muted">· has {p.stock[k] ?? 0}</span></span>
                        <input name={`qty:${k}`} type="number" min="0" max="9999" inputmode="numeric" class="field px-2 py-2" placeholder={String(p.stock[k] ?? 0)} aria-label={k ? `Size ${k} count` : 'Stock count'} />
                      </label>
                    ))}
                  </div>
                  <div class="mt-3 grid grid-cols-2 gap-2">
                    <button name="mode" value="add" class="btn-primary h-12 text-base">Add new stock</button>
                    <button name="mode" value="set" class="btn-outline h-12">Set exact count</button>
                  </div>
                  <p class="mt-2 text-xs muted">“Add new stock” adds to what you have (a delivery from the agent). “Set exact count” replaces it (a stock take). Empty boxes are left as they are.</p>
                </form>
              )}
              {p.trackStock && (
                <form method="post" class="mt-3" onsubmit="return confirm('Stop counting stock for this product? You will set availability by hand.')">
                  <input type="hidden" name="action" value="stop-tracking" />
                  <button class="text-xs font-semibold text-grey underline">Stop counting stock</button>
                </form>
              )}
            </section>

            <section id="photos" class="scroll-mt-24 rounded-3xl bg-white p-5" aria-labelledby="photos-h">
              <h2 id="photos-h" class="display text-3xl">Photos</h2>
              <p class="mt-1 text-sm muted">The first photo is the one shown in the shop.</p>
              <ul class="mt-3 grid grid-cols-3 gap-2">
                {p.photos.map((url, i) => (
                  <li class="relative overflow-hidden rounded-2xl bg-surface">
                    <img src={url} alt={`Photo ${i + 1}`} class="aspect-square w-full object-cover" loading="lazy" />
                    <div class="absolute inset-x-1 bottom-1 flex gap-1">
                      {i > 0 && (
                        <form method="post" class="flex-1">
                          <input type="hidden" name="action" value="photos" /><input type="hidden" name="op" value="first" /><input type="hidden" name="index" value={i} />
                          <button class="w-full rounded-full bg-white/90 py-1 text-[11px] font-semibold">Make first</button>
                        </form>
                      )}
                      <form method="post" onsubmit="return confirm('Remove this photo?')">
                        <input type="hidden" name="action" value="photos" /><input type="hidden" name="op" value="remove" /><input type="hidden" name="index" value={i} />
                        <button class="rounded-full bg-white/90 px-2 py-1 text-[11px] font-semibold text-sale" aria-label={`Remove photo ${i + 1}`}>✕</button>
                      </form>
                    </div>
                  </li>
                ))}
              </ul>
              <div class="mt-3">
                <PhotoUpload productId={p.id} client:visible />
              </div>
            </section>
          </div>
        )}
      </div>
    )
  }
</Admin>
