---
import BackHeader from '../components/BackHeader.astro';
import Icon from '../components/Icon.astro';
import ShopState from '../components/ShopState.astro';
import Shop from '../layouts/Shop.astro';
import { loadCatalog } from '../lib/load';
import { canOrder } from '../lib/models';

const result = await loadCatalog();
const count = (n: number) => `${n} ${n === 1 ? 'item' : 'items'}`;
---
<Shop title="Browse">
  <div class="mx-auto max-w-3xl">
  <BackHeader title="Browse" />
  {!result.ok && <ShopState kind={result.kind} />}
  {
    result.ok && (
      <div class="px-5 pt-4 pb-10">
        <h2 class="text-lg font-bold">Anime series</h2>
        <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
          {result.catalog.series.map((s) => (
            <li>
              <a href={`/?series=${encodeURIComponent(s.id)}`} class="relative flex aspect-[1.6] flex-col justify-end overflow-hidden rounded-[20px] bg-ink p-3.5 text-white">
                {s.imageUrl && <img src={s.imageUrl} alt="" loading="lazy" class="absolute inset-0 size-full object-cover opacity-45" />}
                <span class="relative line-clamp-2 font-bold">{s.name}</span>
                <span class="relative text-xs text-white/70">
                  {count(result.catalog.products.filter((p) => p.seriesId === s.id && canOrder(p)).length)}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <h2 class="mt-8 text-lg font-bold">Categories</h2>
        <ul class="mt-1">
          {result.catalog.categories.map((c) => (
            <li>
              <a href={`/?category=${encodeURIComponent(c.id)}`} class="flex items-center justify-between border-b border-[#ededed] py-3.5">
                <span>
                  <span class="block font-medium">{c.name}</span>
                  <span class="block text-sm muted">{count(result.catalog.products.filter((p) => p.categoryId === c.id && canOrder(p)).length)}</span>
                </span>
                <Icon name="chevron" size={20} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  </div>
</Shop>
