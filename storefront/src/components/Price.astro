---
import { kwacha } from '../lib/money';
import { isOnSale, type ShopProduct } from '../lib/models';

interface Props {
  product: ShopProduct;
  large?: boolean;
}
const { product, large = false } = Astro.props;
---
<span class="inline-flex items-baseline gap-1.5 tabular-nums">
  <span class={`display ${large ? 'text-3xl' : 'text-xl'}`}>{kwacha(product.priceZmw)}</span>
  {isOnSale(product) && <s class="text-xs text-grey">{kwacha(product.compareAtZmw!)}</s>}
</span>
